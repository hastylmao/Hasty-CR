.venvs/
tmp/
__pycache__/
*.py[cod]
.pytest_cache/

# Upstream repositories are installed locally and pinned in vendor/manifest.json.
vendor/*/
!vendor/manifest.json

# Research references and static APK extraction outputs are local evidence only.
_references/


tmp/
scripts/brain/lessons.md

# Pretrained checkpoints ultralytics downloads on demand; not project source.
*.pt

# Pulled APKs and the extracted native libraries: 120MB+ of Supercell binaries,
# reproducible from the device with scripts/extract_game_data.py.
tmp/apk/

# Scratch that has been committed by accident before: pytest dumps, one-off
# debugging snippets, and the PDFs/notes that land at the repo root. Keeping
# these out is what stops a clone carrying someone else's afternoon.
pytest*.txt
pytest*.log
test_progress.txt
scratch_*.py
/claude.pdf
/*.pt

# Runtime state, not source. The live bot rewrites these every match, so tracking
# them means every fork inherits one machine's tuning and every match dirties the
# tree. The .example copies are the shipped defaults; the bot falls back to them.
scripts/brain/config.json
scripts/brain/learned.json
scripts/brain/matchups.json

# Build artifacts and local results.
*.egg-info/
checkpoints/

# Raw diagnostic dumps and the decoded CSV history: hundreds of megabytes of
# per-match traces and column diffs, regenerated by the scripts that made them.
# The analyses written *from* them are markdown and are tracked.
reports/rl_sprint4/matches/
research/csv_history/

# Assistant and editor working directories. Local tooling state, session
# transcripts and personal instruction files - none of it is project source,
# and some of it contains machine paths. Ignored rather than merely untracked
# so a future `git add -A` cannot sweep it into a public repository.
.claude/
.codex/
.opencode/
.cursor/
.continue/
.aider*
.roo/
.kiro/
.gemini/
.windsurfrules
.clinerules
CLAUDE.md
AGENTS.md

# VOD corpus: videos are fetched, measured and deleted; tracks are the artefact
data/vod/videos/
